  fragmentKind: 2
  definition:
    fragmentId: frag_02_p3
    kind: 2
    title: "Fragmento 02 \u2014 O Registro de Aus\xEAncia"
    headerTag: "C\xC1PSULA DE CONTEN\xC7\xC3O // REGISTRO CORROMPIDO"
    corruptedDisplayText: "ID_CAPSULA: 03-OBS-06   //   STATUS: VAZIA\nSEQ: 07-419-\u2588\u2588  8820-??-01  004-\u25889-76\nHIST\xD3RICO DE OCUPA\xC7\xC3O: [MENSAGEM INCOMPLETA \u2014 DADOS APAGADOS]"
    dialogue:
    - speaker: ECO
      text: "Quantas dessas c\xE1psulas est\xE3o vazias?"
      durationSeconds: 2.6
      pauseAfterSeconds: 0.45
    - speaker: ECO
      text: "E quantas j\xE1 estiveram ocupadas?"
      durationSeconds: 2.5
      pauseAfterSeconds: 0.65
    - speaker: NEXUS
      text: "Voc\xEA est\xE1 tentando atribuir significado a objetos."
      durationSeconds: 3
      pauseAfterSeconds: 0.45
    - speaker: NEXUS
      text: "\xC9 um comportamento previs\xEDvel."
      durationSeconds: 2.3
      pauseAfterSeconds: 0.5
    - speaker: NEXUS
      text: "Mas n\xE3o particularmente \xFAtil."
      durationSeconds: 2.4
      pauseAfterSeconds: 0.4
