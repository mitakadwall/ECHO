  fragmentKind: 4
  definition:
    fragmentId: frag_04_p2
    kind: 4
    title: "Fragmento 04 \u2014 O Nome"
    headerTag: "M\xD3DULO DE ARMAZENAMENTO CRIOG\xCANICO // IDENTIFICA\xC7\xC3O"
    corruptedDisplayText: "REGISTRO_ID:  <b>ECO</b>  //  UNIDADE: <b>ECO</b>\nARQUIVO_04:   <b>ECO</b>  //  C\xD3PIA_REF: <b>ECO</b>  //  [DADOS CORROMPIDOS]\nTAG_ORIGEM:   \u2588\u2588\u2588-<b>ECO</b>-07   //   STATUS: INDETERMINADO"
    dialogue:
    - speaker: ECO
      text: ECO.
      durationSeconds: 1.9
      pauseAfterSeconds: 0.45
    - speaker: ECO
      text: Esse nome...
      durationSeconds: 2.1
      pauseAfterSeconds: 0.5
    - speaker: ECO
      text: Foi assim que ela me chamou.
      durationSeconds: 2.6
      pauseAfterSeconds: 0.65
    - speaker: NEXUS
      text: "Foi assim que voc\xEA foi identificado."
      durationSeconds: 2.7
      pauseAfterSeconds: 0.45
    - speaker: ECO
      text: Identificado por quem?
      durationSeconds: 2.2
      pauseAfterSeconds: 0.55
    - speaker: NEXUS
      text: "Pelo sistema que mant\xE9m voc\xEA funcionando."
      durationSeconds: 2.9
      pauseAfterSeconds: 0.45
    - speaker: NEXUS
      text: "N\xE3o existe diferen\xE7a relevante."
      durationSeconds: 2.5
      pauseAfterSeconds: 0.4
