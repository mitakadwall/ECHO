  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Eco.MemoryFragments.MemoryFragmentInteractable
  fragmentKind: 1
  definition:
    fragmentId: frag_01_p4
    kind: 1
    title: "Fragmento 01 \u2014 O Primeiro Registro"
    headerTag: "FRAGMENTO DE MEM\xD3RIA // 01 \u2014 REGISTRO RESIDUAL"
    corruptedDisplayText: "RECONHECIMENTO ESPACIAL ATIVO...\nSETOR DE PROCESSAMENTO // FLASH DE MEM\xD3RIA DETECTADO"
    dialogue:
    - speaker: ECO
      text: "Eu conhe\xE7o esse lugar."
      durationSeconds: 2.4
      pauseAfterSeconds: 0.45
    - speaker: ECO
      text: "N\xE3o... n\xE3o \xE9 poss\xEDvel."
      durationSeconds: 2.3
      pauseAfterSeconds: 0.4
    - speaker: ECO
      text: Eu nunca estive aqui.
      durationSeconds: 2.3
      pauseAfterSeconds: 0.65
    - speaker: NEXUS
      text: Interessante.
      durationSeconds: 1.8
      pauseAfterSeconds: 0.55
    - speaker: NEXUS
      text: "Seu sistema reconheceu o ambiente antes de voc\xEA."
      durationSeconds: 3.1
      pauseAfterSeconds: 0.45
    - speaker: NEXUS
      text: "Isso acontece com frequ\xEAncia, ECO. N\xE3o confunda familiaridade com mem\xF3ria."
      durationSeconds: 3.8
      pauseAfterSeconds: 0.4
