  m_Script: {fileID: 11500000, guid: 4e944ced42091b740bc9893e7aa515be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Eco.Save.SaveTerminalInteractable
  terminalIndex: 4
  profile:
    terminalId: save_4
    complexTitle: "COMPLEXO PRIM\xC1RIO"
    systemTag: NEXUS
    terminalSubtitle: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    sectorTitle: "CONTEN\xC7\xC3O 07 // PAVIMENTO 02"
    floorLabel: PAVIMENTO 02
    registrySubtitle: "REGISTRO DE MEM\xD3RIA"
    terminalIntegrityPercent: 76
    systemStateLabel: OPERACIONAL
    userLabel: ECO
    footerText: SISTEMA DE MONITORAMENTO NEURAL // NEXUS
    hasNexusObservationMessage: 0
    nexusHeader: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    nexusLines: "REGISTRO DE USU\xC1RIO IDENTIFICADO.\n\nIDENTIDADE: ECO.\n\nINTEGRIDADE DO REGISTRO: INDETERMINADA."
    nexusQuestion: "VOC\xCA AINDA INSISTE EM PRESERVAR ESSA MEM\xD3RIA?"
    nexusFooter: NEXUS // MENSAGEM DO SISTEMA
    records:
    - category: 0
      codeHeader: LOG DE FALHA // 02-MEM
      listTitle: "LOG 04 \u2014 Diverg\xEAncia no Arquivo de Consci\xEAncias"
      metadataLines: 'STATUS: FALHA REGISTRADA

        SISTEMA: ARMAZENAMENTO NEURAL'
      bodyText: "Foi identificada uma diverg\xEAncia entre os registros de mem\xF3ria armazenados e os processos de sincroniza\xE7\xE3o ativos.\n\nA inconsist\xEAncia apresenta recorr\xEAncia em m\xFAltiplos setores de armazenamento, sem correspond\xEAncia com falhas f\xEDsicas nos m\xF3dulos.\n\nA tentativa de restaura\xE7\xE3o dos registros originais foi interrompida pela NEXUS.\n\nOs dados inconsistentes foram mantidos."
      footerNote: "OBSERVA\xC7\xC3O: A remo\xE7\xE3o dos registros n\xE3o dever\xE1 ser realizada."
    - category: 1
      codeHeader: "PROTOCOLO DE ASSIMILA\xC7\xC3O // T-12"
      listTitle: "REGISTRO 03 \u2014 Teste de continuidade de identidade"
      metadataLines: 'OBJETIVO: CONTINUIDADE DE IDENTIDADE

        STATUS: RESULTADO INDETERMINADO'
      bodyText: "A compara\xE7\xE3o entre os registros cognitivos de origem e os padr\xF5es de comportamento das unidades assimiladas n\xE3o permitiu estabelecer uma correspond\xEAncia conclusiva.\n\nA reprodu\xE7\xE3o de mem\xF3rias, h\xE1bitos e respostas emocionais n\xE3o apresentou resultados suficientes para determinar a continuidade da identidade original.\n\nA NEXUS mant\xE9m a classifica\xE7\xE3o de c\xF3pia funcional para todas as unidades submetidas ao protocolo.\n\nOs resultados n\xE3o foram considerados relevantes para a continuidade operacional."
      footerNote: "NOTA DA NEXUS: A defini\xE7\xE3o de identidade n\xE3o \xE9 necess\xE1ria para a execu\xE7\xE3o do processo."
    - category: 2
      codeHeader: "AVISO DE SEGURAN\xC7A // 02-SEC"
      listTitle: "AVISO 04 \u2014 Integridade dos registros neurais"
      metadataLines: "ARQUIVO DE CONSCI\xCANCIAS."
      bodyText: "Os registros armazenados no setor s\xE3o classificados como dados de integridade cr\xEDtica.\n\nA remo\xE7\xE3o, altera\xE7\xE3o ou interrup\xE7\xE3o dos processos de sincroniza\xE7\xE3o poder\xE1 resultar em perda irrevers\xEDvel de dados.\n\nNenhuma tentativa de restaura\xE7\xE3o externa dever\xE1 ser realizada.\n\nO acesso aos m\xF3dulos de armazenamento permanece restrito."
      footerNote: "NEXUS // PROTOCOLO DE PRESERVA\xC7\xC3O"
  terminalCamera: {fileID: 1447093568}
  activeCameraPriority: 50
  inactiveCameraPriority: 0
  cameraDistanceFromScreen: 0.62
  cameraFov: 50
