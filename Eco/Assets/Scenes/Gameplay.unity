    corruptedDisplayText: "REPRODUZINDO ARQUIVO: OBS_REC_03.DAT\nSINAL:  \u2593\u2591\u2593\u2593\u2591\u2591\u2591\u2593\u2588\u2593\u2591\u2591\u2593\u2591  [RU\xCDDO / RESPIRA\xC7\xC3O DISTANTE]\nAVISO:  SINAL INCOMPLETO \u2014 INTERFER\xCANCIA DETECTADA"
