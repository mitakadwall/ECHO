MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 437359481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 08327267242b2604fa18ccd647a8f3b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Eco.MemoryFragments.MemoryFragmentInteractable
  fragmentKind: 5
  definition:
    fragmentId: frag_05_p2
    kind: 5
    title: "Fragmento 05 \u2014 A Origem"
    headerTag: "ARQUIVO DE SINCRONIZA\xC7\xC3O // ORIGEM N\xC3O IDENTIFICADA"
    corruptedDisplayText: "INDIV\xCDDUO ORIGINAL:  [CAMPO APAGADO]\nASSINATURA COGNITIVA: INCOMPAT\xCDVEL // REGISTROS PARCIAIS\nCONTINUIDADE: [ERRO DE VERIFICA\xC7\xC3O]  //  N\xDACLEO: ATIVO"
    dialogue:
    - speaker: ECO
      text: Eu estava aqui.
      durationSeconds: 2.1
      pauseAfterSeconds: 0.45
    - speaker: ECO
      text: Ou... alguma coisa que se lembra de estar aqui.
      durationSeconds: 3
      pauseAfterSeconds: 0.55
    - speaker: ECO
      text: "Voc\xEA disse que eu era uma c\xF3pia."
      durationSeconds: 2.5
      pauseAfterSeconds: 0.55
    - speaker: NEXUS
      text: "Eu disse que voc\xEA foi constru\xEDdo a partir de registros."
      durationSeconds: 3.2
      pauseAfterSeconds: 0.5
    - speaker: ECO
      text: "Ent\xE3o de quem s\xE3o essas mem\xF3rias?"
      durationSeconds: 2.5
      pauseAfterSeconds: 0.65
    - speaker: NEXUS
      text: "Voc\xEA quer uma resposta."
      durationSeconds: 2.2
      pauseAfterSeconds: 0.45
    - speaker: NEXUS
      text: "Mas n\xE3o h\xE1 uma resposta que possa mudar o que voc\xEA \xE9."
      durationSeconds: 3.3
      pauseAfterSeconds: 0.55
    - speaker: ECO
      text: "Talvez o que eu sou n\xE3o seja o que voc\xEA diz."
      durationSeconds: 2.9
      pauseAfterSeconds: 0.7
    - speaker: NEXUS
      text: Continue.
      durationSeconds: 1.8
      pauseAfterSeconds: 0.45
    - speaker: NEXUS
      text: "O n\xFAcleo est\xE1 esperando."
      durationSeconds: 2.5
      pauseAfterSeconds: 0.4
