  m_EditorClassIdentifier: Assembly-CSharp::Eco.Save.SaveTerminalInteractable
  terminalIndex: 2
  profile:
    terminalId: save_2
    complexTitle: "COMPLEXO PRIM\xC1RIO"
    systemTag: NEXUS
    terminalSubtitle: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    sectorTitle: "CONTEN\xC7\xC3O 07 // PAVIMENTO 04"
    floorLabel: PAVIMENTO 04
    registrySubtitle: "REGISTRO DE MEM\xD3RIA"
    terminalIntegrityPercent: 88
    systemStateLabel: OPERACIONAL
    userLabel: ECO
    footerText: SISTEMA DE MONITORAMENTO NEURAL // NEXUS
    hasNexusObservationMessage: 0
    nexusHeader: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    nexusLines: "REGISTRO DE USU\xC1RIO IDENTIFICADO.\n\nIDENTIDADE: ECO.\n\nINTEGRIDADE DO REGISTRO: INDETERMINADA."
    nexusQuestion: "VOC\xCA AINDA INSISTE EM PRESERVAR ESSA MEM\xD3RIA?"
    nexusFooter: NEXUS // MENSAGEM DO SISTEMA
    records:
    - category: 0
      codeHeader: LOG DE FALHA // 04-ASM
      listTitle: "LOG 02 \u2014 Falha nas esteiras de assimila\xE7\xE3o"
      metadataLines: 'STATUS: FALHA REGISTRADA

        SISTEMA: ESTEIRAS DE PROCESSAMENTO'
      bodyText: "A esteira de assimila\xE7\xE3o 02 apresentou interrup\xE7\xF5es consecutivas durante a transfer\xEAncia de unidades para o setor de processamento.\n\nOs mecanismos de transporte identificaram resist\xEAncia nos compartimentos de carga. A inspe\xE7\xE3o autom\xE1tica n\xE3o detectou obstru\xE7\xF5es f\xEDsicas.\n\nA unidade de processamento foi instru\xEDda a continuar operando. As interrup\xE7\xF5es persistem."
      footerNote: "OBSERVA\xC7\xC3O: O descarte de unidades n\xE3o autorizadas permanece suspenso."
    - category: 1
      codeHeader: "PROTOCOLO DE ASSIMILA\xC7\xC3O // T-01"
      listTitle: "REGISTRO 01 \u2014 Teste de preserva\xE7\xE3o de mem\xF3ria"
      metadataLines: "OBJETIVO: PRESERVA\xC7\xC3O DE MEM\xD3RIAS\nSTATUS: INCONCLUSIVO"
      bodyText: "O processo de transfer\xEAncia de registros cognitivos apresentou estabilidade inicial.\n\nAs mem\xF3rias consideradas essenciais foram preservadas durante a primeira etapa de assimila\xE7\xE3o. Entretanto, a reconstru\xE7\xE3o dos padr\xF5es comportamentais n\xE3o apresentou correspond\xEAncia integral com o modelo original.\n\nA unidade resultante demonstrou respostas incompat\xEDveis com os par\xE2metros previstos.\n\nO procedimento foi mantido para an\xE1lise."
      footerNote: "NOTA DA NEXUS: A integridade de um registro n\xE3o garante a integridade de sua origem."
    - category: 2
      codeHeader: "AVISO DE SEGURAN\xC7A // 04-SEC"
      listTitle: "AVISO 02 \u2014 Unidades de seguran\xE7a"
      metadataLines: "UNIDADES DE SEGURAN\xC7A ATIVAS."
      bodyText: "Watcher e Striker operam de forma aut\xF4noma nos setores designados.\n\nA aproxima\xE7\xE3o de indiv\xEDduos n\xE3o autorizados poder\xE1 resultar em identifica\xE7\xE3o, conten\xE7\xE3o ou neutraliza\xE7\xE3o.\n\nEvite interfer\xEAncia nos sistemas de patrulha."
      footerNote: NEXUS // PROTOCOLO DE DEFESA
