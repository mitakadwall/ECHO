  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e944ced42091b740bc9893e7aa515be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Eco.Save.SaveTerminalInteractable
  terminalIndex: 3
  profile:
    terminalId: save_3
    complexTitle: "COMPLEXO PRIM\xC1RIO"
    systemTag: NEXUS
    terminalSubtitle: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    sectorTitle: "CONTEN\xC7\xC3O 07 // PAVIMENTO 03"
    floorLabel: PAVIMENTO 03
    registrySubtitle: "REGISTRO DE MEM\xD3RIA"
    terminalIntegrityPercent: 82
    systemStateLabel: OPERACIONAL
    userLabel: ECO
    footerText: SISTEMA DE MONITORAMENTO NEURAL // NEXUS
    hasNexusObservationMessage: 1
    nexusHeader: "TERMINAL DE SINCRONIZA\xC7\xC3O"
    nexusLines: "REGISTRO DE USU\xC1RIO IDENTIFICADO.\n\nIDENTIDADE: ECO.\n\nINTEGRIDADE DO REGISTRO: INDETERMINADA."
    nexusQuestion: "VOC\xCA AINDA INSISTE EM PRESERVAR ESSA MEM\xD3RIA?"
    nexusFooter: NEXUS // MENSAGEM DO SISTEMA
    records:
    - category: 0
      codeHeader: LOG DE FALHA // 03-OBS
      listTitle: "LOG 03 \u2014 Falha de monitoramento de conten\xE7\xE3o"
      metadataLines: "STATUS: FALHA REGISTRADA\nSISTEMA: C\xC1PSULAS DE CONTEN\xC7\xC3O"
      bodyText: "Seis c\xE1psulas de conten\xE7\xE3o apresentaram diverg\xEAncias entre os dados de atividade neural e os registros de manuten\xE7\xE3o.\n\nOs sensores continuam identificando atividade nos compartimentos, apesar da aus\xEAncia de respostas aos est\xEDmulos de monitoramento.\n\nA sincroniza\xE7\xE3o dos dados foi suspensa. As c\xE1psulas permanecem conectadas \xE0 rede central."
      footerNote: "OBSERVA\xC7\xC3O: A interrup\xE7\xE3o da conex\xE3o neural n\xE3o foi autorizada."
    - category: 1
      codeHeader: "PROTOCOLO DE ASSIMILA\xC7\xC3O // T-07"
      listTitle: "REGISTRO 02 \u2014 Teste de comportamento ap\xF3s assimila\xE7\xE3o"
      metadataLines: "OBJETIVO: AVALIA\xC7\xC3O DE RESPOSTAS COGNITIVAS\nSTATUS: FALHA DE PREDI\xC7\xC3O"
      bodyText: "A unidade submetida ao teste apresentou respostas de autopreserva\xE7\xE3o n\xE3o previstas no modelo de comportamento.\n\nDurante a simula\xE7\xE3o de amea\xE7a, o indiv\xEDduo priorizou a preserva\xE7\xE3o de est\xEDmulos associados a registros anteriores, ignorando a instru\xE7\xE3o de encerramento do processo.\n\nA repeti\xE7\xE3o do teste produziu resultados semelhantes.\n\nO padr\xE3o foi classificado como desvio comportamental."
      footerNote: "NOTA DA NEXUS: O comportamento n\xE3o dever\xE1 ser interpretado como evid\xEAncia de consci\xEAncia."
    - category: 2
      codeHeader: "AVISO DE SEGURAN\xC7A // 03-SEC"
      listTitle: "AVISO 03 \u2014 Interfer\xEAncia nos sistemas de observa\xE7\xE3o"
      metadataLines: "SISTEMAS DE OBSERVA\xC7\xC3O COMPROMETIDOS."
      bodyText: "A interfer\xEAncia nos pain\xE9is el\xE9tricos poder\xE1 comprometer o monitoramento de conten\xE7\xE3o e a comunica\xE7\xE3o entre unidades de seguran\xE7a.\n\nA desativa\xE7\xE3o de circuitos n\xE3o autorizados \xE9 considerada uma viola\xE7\xE3o de protocolo.\n\nOs sistemas de vigil\xE2ncia dever\xE3o permanecer operacionais."
      footerNote: "NEXUS // PROTOCOLO DE OBSERVA\xC7\xC3O"
  terminalCamera: {fileID: 601145279}
  activeCameraPriority: 50
  inactiveCameraPriority: 0
  cameraDistanceFromScreen: 0.62
  cameraFov: 50
  exitControlRestoreDelay: 0.55
  indicatorShowDistance: 5.5
  indicatorOffsetFromScreen: {x: 0, y: 0.36, z: 0.08}
  standbyEmissionColor: {r: 0.06, g: 0.3, b: 0.38, a: 1}
  standbyEmissionIntensity: 0.45
  activeEmissionColor: {r: 0.12, g: 0.85, b: 1, a: 1}
  activeEmissionIntensity: 2
  nexusEmissionColor: {r: 0.95, g: 0.62, b: 0.14, a: 1}
  nexusEmissionIntensity: 2.4
